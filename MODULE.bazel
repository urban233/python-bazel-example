standalone_python(
    name = "python_standalone_macos_arm64",
    url = "https://github.com/astral-sh/python-build-standalone/releases/download/20250610/cpython-3.11.13+20250610-aarch64-apple-darwin-install_only.tar.gz",
    sha256 = "365037494ba4f53563c22292e49a8e4d0d495bcb6534fca9666bdd1b474abf36",
