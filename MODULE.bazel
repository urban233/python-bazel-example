module(
    name = "python-bazel-example",
    version = "0.1.0",
)

# Custom repository rule that fetches a standalone CPython interpreter (see
# packaging/standalone_python.bzl for why plain http_archive is not enough).
# use_repo_rule() imports a repository_rule from any .bzl file (not just the
# bundled ones like http_archive).
standalone_python = use_repo_rule("//packaging:standalone_python.bzl", "standalone_python")

# bazel_dep(name = "aspect_rules_py", version = "1.6.4-rc1", dev_dependency = True)
bazel_dep(name = "rules_python", version = "2.3.1")
# rules_pkg lets us assemble zip/tar archives out of build targets.
# We use it to create the self-contained "flat" application bundle.
bazel_dep(name = "rules_pkg", version = "1.0.1")
# `platforms` provides the @platforms//os:... and @platforms//cpu:... constraint
# values used by the platform() definitions and select() in packaging/BUILD.bazel.
bazel_dep(name = "platforms", version = "0.0.11")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.11")
python.toolchain(
    ignore_root_user_error = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.11",
    requirements_lock = "//sdk/python:requirements_lock.txt",
)
use_repo(pip, "pypi")

# ======================================================================================
# Portable application bundle inputs (all operating systems)
#
# The target `//packaging:portable_app` builds a self-contained zip that runs
# WITHOUT needing Python installed on the target machine. It bundles:
#
#   python/  -> a standalone CPython interpreter (this download)
#   app/     -> our Python package + numpy (next download)
#   run.bat  -> the launcher on Windows (run.sh on macOS/Linux)
#
# `http_archive` is normally a WORKSPACE-style rule, but bzlmod allows us to
# import it with `use_repo_rule()` and use it here in MODULE.bazel.
#
# _BUNDLE_BUILD_FILE is injected into the numpy downloads below (the python
# downloads get their BUILD file from standalone_python.bzl instead). It only
# exposes a `filegroup(name = "files")` containing every file (minus large
# *.pdb debug symbols, the marker files Bazel injects, and bundled test
# suites). `pkg_files` in packaging/BUILD.bazel reads that filegroup and maps
# the contents into the bundle.
# ======================================================================================
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_BUNDLE_BUILD_FILE = """\
filegroup(
    name = "files",
    srcs = glob(
        ["**"],
        exclude = [
            "*.pdb",  # debug symbols, not needed at runtime
            "**/*.pdb",
            "BUILD.bazel",  # files Bazel injects into the repo; not part of the runtime
            "WORKSPACE",
            "REPO.bazel",
            "MODULE.bazel",
            "**/__pycache__/**",
            "**/test/**",  # bundled test suites (large, unused at runtime)
            "**/tests/**",
        ],
    ),
    visibility = ["//visibility:public"],
)
"""

# ----------------------------------------------------------------------------------
# 1) Standalone CPython 3.11.13 for every OS/CPU combination we ship (from
#    astral-sh "python-build-standalone", the same upstream build rules_python
#    uses for its hermetic toolchain). Each tarball's only top-level directory
#    is "python/", so the rule's `strip_prefix = "python"` moves its contents to
#    the repo root. Windows has python.exe + python311.dll + Lib/; macOS/Linux
#    have bin/python3 + lib/python3.11/ instead.
#
#    `standalone_python` is a tiny custom repository rule (see
#    packaging/standalone_python.bzl) -- a plain http_archive cannot remove the
#    symlink-loop directory that the Linux builds ship in share/terminfo.
#    The repo name suffix (_windows_x86_64, _linux_aarch64, ...) is arbitrary;
#    packaging/BUILD.bazel maps each target platform to one of these via
#    select(). Note: MODULE.bazel does NOT support `for` loops, so the five
#    platforms are written out explicitly (only URL + sha256 differ).
# ----------------------------------------------------------------------------------
standalone_python(
    name = "python_standalone_windows_x86_64",
    url = "https://github.com/astral-sh/python-build-standalone/releases/download/20250610/cpython-3.11.13+20250610-x86_64-pc-windows-msvc-install_only.tar.gz",
    sha256 = "c0f89e3776211147817d54084fa046e2603571e18ff2ae4a4a8ff84ca4f7defc",
)

standalone_python(
    name = "python_standalone_linux_x86_64",
    url = "https://github.com/astral-sh/python-build-standalone/releases/download/20250610/cpython-3.11.13+20250610-x86_64-unknown-linux-gnu-install_only.tar.gz",
    sha256 = "d93a7699505ee0ac7dec0f09324ffb19a31cce3066a287bb1fe95285ce3ea0c7",
    delete_terminfo = True,
)

standalone_python(
    name = "python_standalone_linux_aarch64",
    url = "https://github.com/astral-sh/python-build-standalone/releases/download/20250610/cpython-3.11.13+20250610-aarch64-unknown-linux-gnu-install_only.tar.gz",
    sha256 = "a5954f147e87d9bff3d9733ebb3e74fe997eec5b38eaf5cb4429038228962a16",
