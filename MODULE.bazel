standalone_python(
    name = "python_standalone_macos_x86_64",
    url = "https://github.com/astral-sh/python-build-standalone/releases/download/20250610/cpython-3.11.13+20250610-x86_64-apple-darwin-install_only.tar.gz",
    sha256 = "b49044115a545e67d73f5265a613a25da7c9523431281aa7b94691f1013355af",
