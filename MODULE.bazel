# ----------------------------------------------------------------------------------
# 2) The numpy wheel per platform, as a plain download. A .whl file is just a
#    ZIP, so Bazel can unpack it directly with `type = "zip"`. After extraction
#    the repo root contains numpy/, numpy.libs/ (Windows) and
#    numpy-2.3.2.dist-info/ -- exactly what would sit in site-packages/.
#
#    Note: we deliberately download the wheel ourselves instead of reusing the
#    `@pypi//numpy` target, because Bazel's py_library only exposes the .py
#    files. numpy also ships compiled .pyd/.so/.dylib binaries which we need,
#    and only the full wheel contains them. The sha256 values match the hashes
#    pip pins for numpy 2.3.2 (cp311). Written out explicitly (no loops allowed
#    in MODULE.bazel); only URL + sha256 differ per platform.
# ----------------------------------------------------------------------------------
http_archive(
    name = "numpy_wheel_windows_x86_64",
    url = "https://files.pythonhosted.org/packages/d5/03/0eade211c504bda872a594f045f98ddcc6caef2b7c63610946845e304d3f/numpy-2.3.2-cp311-cp311-win_amd64.whl",
    sha256 = "240259d6564f1c65424bcd10f435145a7644a65a6811cfc3201c4a429ba79170",
    type = "zip",
    build_file_content = _BUNDLE_BUILD_FILE,
)

http_archive(
    name = "numpy_wheel_linux_x86_64",
    url = "https://files.pythonhosted.org/packages/c8/b0/fbeee3000a51ebf7222016e2939b5c5ecf8000a19555d04a18f1e02521b8/numpy-2.3.2-cp311-cp311-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl",
    sha256 = "20b8200721840f5621b7bd03f8dcd78de33ec522fc40dc2641aa09537df010c3",
    type = "zip",
    build_file_content = _BUNDLE_BUILD_FILE,
)

http_archive(
    name = "numpy_wheel_linux_aarch64",
    url = "https://files.pythonhosted.org/packages/17/f2/e4d72e6bc5ff01e2ab613dc198d560714971900c03674b41947e38606502/numpy-2.3.2-cp311-cp311-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl",
    sha256 = "f75018be4980a7324edc5930fe39aa391d5734531b1926968605416ff58c332d",
